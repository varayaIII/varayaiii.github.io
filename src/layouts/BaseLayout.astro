---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Victor Araya — VoIP Engineer building toward DevOps. Portfolio, labs, and technical notes on automation, cloud, and infrastructure.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Victor Araya</title>
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    <Header />
    <main class="mx-auto max-w-4xl px-6 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
