---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

const social = {
  github: 'https://github.com/varayaIII',
  linkedin: 'https://www.linkedin.com/in/victor-a-1630b561',
  email: 'mailto:contact@varaya.dev',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Victor Araya — VoIP Engineer building toward DevOps. Site under construction." />
    <title>Victor Araya · Coming soon</title>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-bg px-6 text-center font-sans text-text antialiased">
    <p class="font-mono text-sm uppercase tracking-wide text-accent-cyan">Under construction</p>
    <h1 class="mt-4 font-display text-3xl font-semibold sm:text-4xl">
      victor<span class="text-accent">@</span>araya<span class="text-muted">:~$</span>
    </h1>
    <p class="mt-4 max-w-md text-muted">
      VoIP Engineer building toward DevOps. I'm still putting this site together — check back soon.
    </p>
    <div class="mt-8 flex gap-5">
      <a href={social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-muted transition-colors hover:text-accent-cyan">
        <Icon name="github" class="h-5 w-5" />
      </a>
      <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-muted transition-colors hover:text-accent-cyan">
        <Icon name="linkedin" class="h-5 w-5" />
      </a>
      <a href={social.email} aria-label="Email" class="text-muted transition-colors hover:text-accent-cyan">
        <Icon name="mail" class="h-5 w-5" />
      </a>
    </div>
  </body>
</html>