---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
---

<BaseLayout title="About Me">
  <h1 class="font-display text-3xl font-semibold tracking-tight text-white">About me</h1>

  <div class="mt-8">
    <AuthorCard variant="full" />
  </div>

  <div class="mt-10 rounded-lg border border-dashed border-border p-6 text-center text-muted">
    <p>
      I'm still writing the full story of my transition from NOC to DevOps — check back soon,
      or <a href="/contact" class="text-accent-cyan hover:underline">reach out directly</a> if you'd like to know more right now.
    </p>
  </div>
</BaseLayout>
