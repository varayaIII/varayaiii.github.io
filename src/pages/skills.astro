---
import BaseLayout from '../layouts/BaseLayout.astro';

// Grouped by domain, not a flat list — this reflects your real profile:
// solid networking/telecom foundation + a DevOps stack actively under construction.
const skillGroups = [
  {
    domain: 'Networking & Telecom',
    level: 'Solid experience',
    items: ['VoIP', 'SIP / RTP', 'Asterisk', 'SBCs', 'SMS / Messaging', 'NOC / 24x7 Monitoring', 'Network troubleshooting'],
  },
  {
    domain: 'Systems & Linux',
    level: 'Solid experience',
    items: ['Linux administration', 'Bash scripting', 'MySQL', 'Service management', 'Infrastructure monitoring'],
  },
  {
    domain: 'DevOps & Automation',
    level: 'Actively learning',
    items: ['Docker', 'Terraform', 'Ansible', 'CI/CD (GitHub Actions)', 'Git / GitHub / GitLab'],
  },
  {
    domain: 'Cloud',
    level: 'Actively learning',
    items: ['AWS (EC2, S3, IAM, VPC)', 'Cloud architecture fundamentals'],
  },
  {
    domain: 'Scripting & Tools',
    level: 'Actively learning',
    items: ['Python', 'Observability (Prometheus/Grafana)', 'Markdown / Technical documentation'],
  },
];
---

<BaseLayout title="Skills">
  <h1 class="font-display text-3xl font-semibold tracking-tight text-white">Skills</h1>
  <p class="mt-4 max-w-2xl text-muted">
    My foundation is in networking and telecom; my current focus is DevOps and automation.
    This page reflects both sides of my profile, without inflating what I'm still learning.
  </p>

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {skillGroups.map((group) => (
      <div class="rounded-lg border border-border p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-display font-semibold text-white">{group.domain}</h2>
          <span class="text-xs text-accent-cyan">{group.level}</span>
        </div>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-md bg-surface px-2.5 py-1 text-xs text-text">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>
