---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { label: 'Email', value: 'contacto@varaya.dev', href: 'mailto:contacto@varaya.dev' },
  { label: 'GitHub', value: 'github.com/TU_USUARIO', href: 'https://github.com/TU_USUARIO' },
  { label: 'LinkedIn', value: 'linkedin.com/in/TU_USUARIO', href: 'https://linkedin.com/in/TU_USUARIO' },
];
---

<BaseLayout title="Contact">
  <h1 class="font-display text-3xl font-semibold tracking-tight text-white">Let's talk</h1>
  <p class="mt-4 max-w-2xl text-muted">
    I'm open to conversations about DevOps, automation, or cloud opportunities,
    or simply exchanging ideas about infrastructure and networking.
  </p>

  <div class="mt-10 flex flex-col gap-3">
    {links.map((link) => (
      <a
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel="noopener noreferrer"
        class="flex items-center justify-between rounded-lg border border-border px-5 py-4 transition-colors hover:border-accent/50 hover:bg-surface"
      >
        <span class="font-medium text-white">{link.label}</span>
        <span class="text-sm text-muted">{link.value}</span>
      </a>
    ))}
  </div>
</BaseLayout>
