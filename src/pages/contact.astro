---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { label: 'Email', value: 'contacto@varaya.dev', href: 'mailto:contacto@varaya.dev' },
  { label: 'GitHub', value: 'github.com/TU_USUARIO', href: 'https://github.com/TU_USUARIO' },
  { label: 'LinkedIn', value: 'linkedin.com/in/TU_USUARIO', href: 'https://linkedin.com/in/TU_USUARIO' },
];
---

<BaseLayout title="Contacto">
  <h1 class="text-3xl font-bold tracking-tight text-white">Hablemos</h1>
  <p class="mt-4 max-w-2xl text-slate-400">
    Estoy abierto a conversar sobre oportunidades en DevOps, automatización o cloud,
    o simplemente a intercambiar ideas sobre infraestructura y redes.
  </p>

  <div class="mt-10 flex flex-col gap-3">
    {links.map((link) => (
      <a
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel="noopener noreferrer"
        class="flex items-center justify-between rounded-lg border border-slate-800 px-5 py-4 transition-colors hover:border-teal-500/50 hover:bg-slate-900/50"
      >
        <span class="font-medium text-white">{link.label}</span>
        <span class="text-sm text-slate-400">{link.value}</span>
      </a>
    ))}
  </div>
</BaseLayout>
