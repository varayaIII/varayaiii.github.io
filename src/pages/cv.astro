---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV">
  <div class="flex items-center justify-between">
    <h1 class="font-display text-3xl font-semibold tracking-tight text-white">Curriculum Vitae</h1>
    <!-- Put your real CV at /public/cv.pdf and this button serves it directly -->
    <a href="/cv.pdf" download
       class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-bg hover:bg-accent-cyan transition-colors">
      Download PDF
    </a>
  </div>

  <div class="prose prose-invert mt-10 max-w-none prose-headings:font-semibold">
    <!-- TODO: replace with your real experience -->
    <h2>Experience</h2>
    <p>Content pending: roles, companies, dates, and concrete achievements in NOC/VoIP/Telecom.</p>

    <h2>Education</h2>
    <p>Content pending: formal education and certifications.</p>

    <h2>Certifications in progress</h2>
    <p>Content pending: e.g. AWS Cloud Practitioner, Terraform Associate, etc.</p>
  </div>
</BaseLayout>
