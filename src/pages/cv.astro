---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Checks at build time whether a real CV file was added — the button only
// appears once public/cv.pdf actually exists, so it can never 404.
const cvExists = fs.existsSync(path.join(process.cwd(), 'public/cv.pdf'));
---

<BaseLayout title="CV">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-3xl font-semibold tracking-tight text-white">Curriculum Vitae</h1>
    {cvExists && (
      <a href="/cv.pdf" download
         class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-bg hover:bg-accent-cyan transition-colors">
        Download PDF
      </a>
    )}
  </div>

  <div class="mt-10 rounded-lg border border-dashed border-border p-6 text-center text-muted">
    <p>
      My detailed experience and education are coming soon.
      Want the full picture right now? <a href="/contact" class="text-accent-cyan hover:underline">Get in touch</a>.
    </p>
  </div>
</BaseLayout>
