---
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const social = {
  github: 'https://github.com/TU_USUARIO',
  linkedin: 'https://linkedin.com/in/TU_USUARIO',
  email: 'mailto:contacto@varaya.dev',
};
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-6 py-8 text-sm text-muted">
    <p>&copy; {year}</p>
    <div class="flex gap-4">
      <a href={social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="transition-colors hover:text-accent-cyan">
        <Icon name="github" class="h-4 w-4" />
      </a>
      <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="transition-colors hover:text-accent-cyan">
        <Icon name="linkedin" class="h-4 w-4" />
      </a>
      <a href={social.email} aria-label="Email" class="transition-colors hover:text-accent-cyan">
        <Icon name="mail" class="h-4 w-4" />
      </a>
    </div>
  </div>
</footer>
