---
interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;

// Centraliza tus datos acá. Cuando los tengas definitivos, edita solo este bloque
// y se actualiza en todo el sitio (About + pie de cada post).
const author = {
  name: 'Victor Araya',
  role: 'Ingeniero en Telecomunicaciones · en transición a DevOps',
  bio: 'Desde el NOC hacia la nube: años gestionando VoIP, SIP y redes en producción, ahora aplicando esa misma disciplina de confiabilidad a la automatización y la infraestructura como código.',
  github: 'https://github.com/TU_USUARIO',
  linkedin: 'https://linkedin.com/in/TU_USUARIO',
  email: 'contacto@varaya.dev',
};
---

{variant === 'full' ? (
  <div class="flex flex-col gap-6 rounded-xl border border-slate-800 bg-slate-900/50 p-8 sm:flex-row sm:items-start">
    <div class="h-24 w-24 shrink-0 rounded-full bg-gradient-to-br from-teal-500 to-slate-700"></div>
    <div>
      <h2 class="text-xl font-semibold text-white">{author.name}</h2>
      <p class="mt-1 text-sm font-medium text-teal-400">{author.role}</p>
      <p class="mt-4 text-slate-300 leading-relaxed">{author.bio}</p>
      <div class="mt-5 flex gap-4 text-sm">
        <a href={author.github} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">GitHub</a>
        <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">LinkedIn</a>
        <a href={`mailto:${author.email}`} class="text-slate-400 hover:text-white transition-colors">Email</a>
      </div>
    </div>
  </div>
) : (
  <div class="flex items-center gap-4">
    <div class="h-12 w-12 shrink-0 rounded-full bg-gradient-to-br from-teal-500 to-slate-700"></div>
    <div>
      <p class="text-sm font-medium text-white">Escrito por {author.name}</p>
      <p class="text-xs text-slate-400">{author.role}</p>
    </div>
  </div>
)}
