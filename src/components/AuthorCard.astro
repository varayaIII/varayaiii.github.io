---
import Icon from './Icon.astro';

interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;

// Centralize your data here. Once finalized, edit only this block
// and it updates across the whole site (About + footer of each post).
const author = {
  name: 'Victor Araya',
  role: 'VoIP Engineer · building toward DevOps and Cloud',
  bio: 'VoIP Engineer with a solid background in NOC and production networks — SIP, RTP, SBCs, Asterisk. Now adding automation and infrastructure as code to that same reliability mindset.',
  github: 'https://github.com/varayaIII',
  linkedin: 'https://linkedin.com/in/victor-a-1630b561/',
  email: 'contacto@varaya.dev',
};
---

{variant === 'full' ? (
  <div class="flex flex-col gap-6 rounded-xl border border-border bg-surface p-8 sm:flex-row sm:items-start">
    <div class="h-24 w-24 shrink-0 rounded-full bg-gradient-to-br from-accent to-accent-cyan"></div>
    <div>
      <h2 class="font-display text-xl font-semibold text-white">{author.name}</h2>
      <p class="mt-1 text-sm font-medium text-accent-cyan">{author.role}</p>
      <p class="mt-4 leading-relaxed text-text">{author.bio}</p>
      <div class="mt-5 flex gap-4">
        <a href={author.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-muted transition-colors hover:text-accent-cyan">
          <Icon name="github" class="h-5 w-5" />
        </a>
        <a href={author.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-muted transition-colors hover:text-accent-cyan">
          <Icon name="linkedin" class="h-5 w-5" />
        </a>
        <a href={`mailto:${author.email}`} aria-label="Email" class="text-muted transition-colors hover:text-accent-cyan">
          <Icon name="mail" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </div>
) : (
  <div class="flex items-center gap-4">
    <div class="h-12 w-12 shrink-0 rounded-full bg-gradient-to-br from-accent to-accent-cyan"></div>
    <div>
      <p class="text-sm font-medium text-white">Written by {author.name}</p>
      <p class="text-xs text-muted">{author.role}</p>
    </div>
  </div>
)}
