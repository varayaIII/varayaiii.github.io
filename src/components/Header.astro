---
import Icon from './Icon.astro';

const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Skills', href: '/skills' },
  { label: 'Contact', href: '/contact' },
];

// Edit your real links here — also used in Footer and AuthorCard.
const social = {
  github: 'https://github.com/TU_USUARIO',
  linkedin: 'https://linkedin.com/in/TU_USUARIO',
  email: 'mailto:contacto@varaya.dev',
};

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border">
  <nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-mono text-sm font-semibold text-white">
      victor<span class="text-accent">@</span>araya<span class="text-muted">:~$</span>
    </a>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                class={`transition-colors hover:text-accent-cyan ${isActive ? 'font-medium text-accent-cyan' : 'text-muted'}`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="flex items-center gap-3 border-l border-border pl-5">
        <a href="/cv" aria-label="CV" class="text-muted transition-colors hover:text-accent-cyan">
          <Icon name="file" class="h-4 w-4" />
        </a>
        <a href={social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-muted transition-colors hover:text-accent-cyan">
          <Icon name="github" class="h-4 w-4" />
        </a>
        <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-muted transition-colors hover:text-accent-cyan">
          <Icon name="linkedin" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </nav>
</header>
