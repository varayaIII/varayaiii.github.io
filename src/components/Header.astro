---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Proyectos', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Skills', href: '/skills' },
  { label: 'CV', href: '/cv' },
  { label: 'Contacto', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-800">
  <nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-mono text-sm font-semibold text-white">
      victor<span class="text-teal-400">@</span>araya<span class="text-slate-500">:~$</span>
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              class={`transition-colors hover:text-teal-400 ${isActive ? 'text-teal-400 font-medium' : 'text-slate-400'}`}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
